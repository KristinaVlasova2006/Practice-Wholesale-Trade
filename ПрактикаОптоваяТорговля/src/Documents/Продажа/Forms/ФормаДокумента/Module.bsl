#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС; 
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура СписокНоменклатурыКоличествоПриИзменении(Элемент)
	ТекущиеДанные = Элементы.СписокНоменклатуры.ТекущиеДанные;
	РассчитатьСуммуСтроки(ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура СписокНоменклатурыЦенаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.СписокНоменклатуры.ТекущиеДанные;
	РассчитатьСуммуСтроки(ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура СписокНоменклатурыНоменклатураПриИзменении(Элемент)
	ТекущиеДанные = Элементы.СписокНоменклатуры.ТекущиеДанные;
	
	Цена = ПолучитьЦенуНоменклатуры(ТекущиеДанные.Номенклатура, Объект.Дата);
	ТекущиеДанные.Цена = Цена;
	
	// Получаем ставку НДС из справочника Номенклатура
	//СтавкаНДС = ПолучитьСтавкуНДСНоменклатурыНаСервере(ТекущиеДанные.Номенклатура);
	//ТекущиеДанные.СтавкаНДС = СтавкаНДС;
	
	РассчитатьСуммуСтроки(ТекущиеДанные);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЦенуНоменклатуры(Номенклатура, Дата)
	Возврат РаботаСЦенами.ПолучитьЦенуНоменклатуры(Номенклатура, Дата)
КонецФункции

&НаКлиенте
Процедура СписокНоменклатурыСтавкаНДСПриИзменении(Элемент)
	ТекущиеДанные = Элементы.СписокНоменклатуры.ТекущиеДанные;
	РассчитатьСуммуСтроки(ТекущиеДанные);
КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ДанныеСтроки)
	Скидка = Объект.Скидка / 100;
	ДанныеСтроки.Сумма = ДанныеСтроки.Цена * ДанныеСтроки.Количество * (1 - Скидка);
	РассчитатьСуммуСтрокиСНДС(ДанныеСтроки);
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуСтрокиСНДС(ДанныеСтроки)
	СтавкаНДС = ДанныеСтроки.СтавкаНДС; 
	
	Если СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС") Тогда
		ДанныеСтроки.СуммаСНДС = ДанныеСтроки.Сумма;
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС5") Тогда
		ДанныеСтроки.СуммаСНДС = ДанныеСтроки.Сумма * 1.05;
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС7") Тогда
		ДанныеСтроки.СуммаСНДС = ДанныеСтроки.Сумма * 1.07;
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10") Тогда
		ДанныеСтроки.СуммаСНДС = ДанныеСтроки.Сумма * 1.1;
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22") Тогда
		ДанныеСтроки.СуммаСНДС = ДанныеСтроки.Сумма * 1.22;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

&НаСервереБезКонтекста
Функция ПолучитьЦенуНоменклатурыНаСервере(Номенклатура)
	Цена = Номенклатура.Цена;
	Возврат Цена;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСтавкуНДСНоменклатурыНаСервере(Номенклатура)
	Возврат Номенклатура.СтавкаНДС;
КонецФункции

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СкидкаПриИзменении(Элемент)
	Для Каждого Строка Из Объект.СписокНоменклатуры Цикл
		РассчитатьСуммуСтроки(Строка);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

