Процедура ОбработкаПроведения(Отказ, Режим)

    // 0. Определяем регистр-приёмник и вид движения по виду договора
    Если Договор.ВидДоговора = Перечисления.ВидыДоговоров.СПоставщиком Тогда
        ИмяРегистра = "ВзаиморасчётыСПоставщиками";
        ВидДвижения = ВидДвиженияНакопления.Расход;
    ИначеЕсли Договор.ВидДоговора = Перечисления.ВидыДоговоров.СПокупателем Тогда
        ИмяРегистра = "ВзаиморасчётыСПокупателем";
        ВидДвижения = ВидДвиженияНакопления.Приход;
    КонецЕсли;

    // Контроль отрицательных остатков — только для Расход-направлений (новая методика)
    Если ВидДвижения = ВидДвиженияНакопления.Расход Тогда

        // 1. Помечаем набор записей: блокировка будет наложена в момент Записать()
        Движения[ИмяРегистра].БлокироватьДляИзменения = Истина;

        // 2. Безусловное формирование движений-расход
        Движение = Движения[ИмяРегистра].Добавить();
        Движение.ВидДвижения = ВидДвижения;
        Движение.Период = Дата;
        Движение.Контрагент = Контрагент;
        Движение.Договор = Договор;
        Движение.Сумма = Сумма;

        // 3. Явная запись движений в БД
        Движения[ИмяРегистра].Записать();

        // 4. Запрос остатков с параметром Граница(МоментВремени(), ВидГраницы.Включая)
        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ
        |   РегОстатки.СуммаОстаток КАК СуммаОстаток
        |ИЗ
        |   РегистрНакопления." + ИмяРегистра + ".Остатки(
        |       &Граница,
        |       Контрагент = &Контрагент
        |           И Договор = &Договор) КАК РегОстатки
        |ГДЕ
        |   РегОстатки.СуммаОстаток < 0";

        Запрос.УстановитьПараметр("Граница",
            Новый Граница(МоментВремени(), ВидГраницы.Включая));
        Запрос.УстановитьПараметр("Контрагент", Контрагент);
        Запрос.УстановитьПараметр("Договор", Договор);

        РезультатЗапроса = Запрос.Выполнить();
        Если НЕ РезультатЗапроса.Пустой() Тогда
            Отказ = Истина;

            Сообщение = Новый СообщениеПользователю;
            Сообщение.Текст = СтрШаблон(
                "Сумма списания (%1) превышает остаток задолженности — проведение невозможно",
                Сумма);
            Сообщение.Поле = "Сумма";
            Сообщение.УстановитьДанные(ЭтотОбъект);
            Сообщение.Сообщить();
        КонецЕсли;

    Иначе
        // Для Приход-направлений — просто записать движение, контроль не требуется
        Движения[ИмяРегистра].Записывать = Истина;
        Движение = Движения[ИмяРегистра].Добавить();
        Движение.ВидДвижения = ВидДвижения;
        Движение.Период = Дата;
        Движение.Контрагент = Контрагент;
        Движение.Договор = Договор;
        Движение.Сумма = Сумма;
    КонецЕсли;

КонецПроцедуры
